# Copy to .env for local development. Not needed when running as a Databricks App
# (there the host and service-principal credentials are injected automatically).

# SQL warehouse > Connection details
DATABRICKS_SERVER_HOSTNAME=dbc-xxxxxxxx-xxxx.cloud.databricks.com
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/xxxxxxxxxxxxxxxx
# Personal access token (User settings > Developer > Access tokens).
# Leave empty to use the Databricks SDK auth chain (e.g. `databricks auth login`).
DATABRICKS_TOKEN=

IA_SOURCE_TABLE=workspace.default.attruby_ia
IA_CACHE_TTL_SECONDS=300
IA_POOL_SIZE=4
# Comma-separated frontend origins, e.g. http://localhost:5173
IA_CORS_ORIGINS=*
LOG_LEVEL=INFO
